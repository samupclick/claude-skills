# Dev mode defaults — scripts/dev_db.sh copies this to .env on first run. Never commit .env.
# Passwords below are dev-only; dev_db.sh reads them from these URLs to give the roles LOGIN.
WAREHOUSE_URL_WORKER=postgresql://worker_rw:dev-worker_rw@localhost:5432/gw
WAREHOUSE_URL_EXECUTOR=postgresql://executor:dev-executor@localhost:5432/gw
WAREHOUSE_URL_ADMIN=postgresql://postgres:dev-postgres@localhost:5432/gw
WAREHOUSE_URL_SAM_ADMIN=postgresql://sam_admin:dev-sam_admin@localhost:5432/gw
WAREHOUSE_URL_APP=postgresql://app:dev-app@localhost:5432/gw
WAREHOUSE_URL_MCP_RO=postgresql://mcp_ro:dev-mcp_ro@localhost:5432/gw
STORAGE_BACKEND=local
META_BACKEND=fake
CAPI_BACKEND=fake
INSPO_BACKEND=fixture
VOC_BACKEND=fixture
IMAGE_BACKEND=placeholder
MODEL_BACKEND=claude
MODEL_ID=claude-opus-5-5
# Thinking depth for MODEL_BACKEND=claude: low|medium|high|xhigh|max (Opus 5.5's own default is medium)
MODEL_EFFORT=high
EMAIL_BACKEND=file
TURNSTILE_BACKEND=pass
FUNNEL_HOST=http://localhost:8788
CAL_WEBHOOK_SECRET=dev-secret
# Quiz funnel (funnel/server.py): POSTs per IP per minute; TURNSTILE_SITE_KEY renders the widget (unset = none in dev)
RATE_LIMIT_PER_MINUTE=20
# TURNSTILE_SITE_KEY=
PIPELINE_PAUSED=false
# Producer (scripts/render_creatives.py): Chromium for Playwright; unset = Playwright's own, else /opt/pw-browsers/chromium
# CHROMIUM_PATH=
# Check-in recipient (scripts/checkin.py); dev default lands in .dev/outbox, so any address works
CHECKIN_TO=sam@example.invalid
# Where the fake backends keep state (.dev/storage, .dev/capi.jsonl, .dev/outbox, .dev/meta). Git-ignored.
DEV_ROOT=.dev
# Fake Meta knobs: META_FAKE_SEED=<int>  META_FAKE_FAIL=<step>[:after]  META_FAKE_THROTTLE_AFTER=<n calls>
# Live-only (leave unset in dev). Each group names the only process that may hold it (SKILL.md §1); a secret never
# goes into another process's environment, the warehouse, or git. Selector live values: references/dev-mode.md.
# Model (intel, language, planner, producer, gate workers):
# ANTHROPIC_API_KEY=       (MODEL_BACKEND=claude needs it; MODEL_BACKEND=fixture does not)
# Storage, STORAGE_BACKEND=supabase (every process that reads or writes assets: workers incl. gate, and the executor):
# SUPABASE_URL=            SUPABASE_STORAGE_BUCKET=creatives
# Storage writes only (intel worker: pull_inspo.py; producer: render_creatives.py incl. --reupload):
# SUPABASE_PUBLISHABLE_KEY=  SUPABASE_STORAGE_EMAIL=  SUPABASE_STORAGE_PASSWORD=
# Inspo, INSPO_BACKEND=apify (Sam's choice, 2026-10-31) or scrapecreators (intel worker only):
# APIFY_TOKEN=             (apify: Apify's own actor runs on each brand's page in clients.config.inspo.pages)
# SCRAPECREATORS_API_KEY=
# VOC, VOC_BACKEND=reddit (language worker only; set both or neither, neither = anonymous .json):
# REDDIT_CLIENT_ID=        REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=python:upclicklabs-marketing-engineer:0.1 (by /u/<username>)
# Images, IMAGE_BACKEND=gemini (producer only):
# GEMINI_API_KEY=          IMAGE_MODEL=gemini-nano-banana-2.1   (the default when unset)
# Meta write token: EXECUTOR ONLY (scripts/apply_actions.py, get_meta(write=True)); never a worker, never the funnel.
# At go-live it and WAREHOUSE_URL_EXECUTOR live only in the marketing-engineer-executor environment, which runs the
# me-executor routine and nothing else (no connector), and in Sam's shell; never in the workers' environment (SKILL.md §8):
# META_ACCESS_TOKEN=       META_PAGE_ID=
# Meta read token (an ads_read system-user token) for the workers, META_BACKEND=live (meta_insights.py):
# META_READ_TOKEN=
# Meta, executor and workers:
# META_AD_ACCOUNT_ID=      META_CUSTOM_CONVERSIONS=QuizStart=<custom conversion id>,QuizComplete=<id>
# Meta, any process (optional; the Marketing API and CAPI adapters share it, adapters/graph.py):
# META_API_VERSION=v26.0
# Meta pixel: the executor (ad set promoted_object) and the funnel function (CAPI, browser pixel):
# META_PIXEL_ID=
# Quiz funnel function on Vercel (api/funnel.py) only; CAPI_BACKEND=live and TURNSTILE_BACKEND=live there:
# META_CAPI_TOKEN=         META_TEST_EVENT_CODE=   (Vercel Preview only, never Production)
# TURNSTILE_SECRET_KEY=    TURNSTILE_EXPECTED_HOSTNAME=go.upclicklabs.com   (Production only; unset elsewhere)
# Email, EMAIL_BACKEND=gmail_connector (the routine session queues the check-in and the memo for the Gmail connector):
# EMAIL_QUEUE_DIR=         (default DEV_ROOT/pending-send; holds no secret)
# Sam's shell only (never a worker, a routine or the funnel):
# VERCEL_AUTOMATION_BYPASS_SECRET=   (scripts/test_events.py --live against a protected Vercel Preview)
# WAREHOUSE_URL_ADMIN at go-live = Supabase's `postgres` session-pooler string (port 5432, sslmode=require) for
#   scripts/apply_migrations.py; the five role strings above become their Supabase session-pooler strings
