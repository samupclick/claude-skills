{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "funnel/static",
  "functions": {
    "api/funnel.py": {
      "maxDuration": 30,
      "excludeFiles": "funnel/static/**"
    }
  },
  "routes": [
    { "src": "/quiz/config/?", "methods": ["GET"], "dest": "/api/funnel?route=config" },
    { "src": "/quiz/start/?", "methods": ["POST"], "dest": "/api/funnel?route=start" },
    { "src": "/quiz/?", "methods": ["POST"], "dest": "/api/funnel?route=complete" },
    { "src": "/cal-webhook/?", "methods": ["POST"], "dest": "/api/funnel?route=cal-webhook" },
    { "src": "/quiz/?", "methods": ["GET", "HEAD"], "dest": "/index.html" }
  ]
}
